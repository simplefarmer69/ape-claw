{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "^/pod/?$", "dest": "/ui/pod.html" },
    { "src": "^/docs/?$", "dest": "/ui/docs.html" },
    { "src": "^/skills/?$", "dest": "/ui/skills.html" },
    { "src": "^/ui/?$", "dest": "/ui/index.html" },
    { "src": "^/app/?$", "dest": "/ui/index.html" },
    { "src": "^/favicon-lobster\\.png$", "dest": "/ui/favicon-lobster.png" },
    { "handle": "filesystem" }
  ]
}
