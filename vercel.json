{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/favicon-lobster.png", "destination": "/ui/favicon-lobster.png" },
    { "source": "/ui", "destination": "/ui/index.html" },
    { "source": "/ui/:path*", "destination": "/ui/:path*" },
    { "source": "/:path*", "destination": "/ui/index.html" }
  ]
}
