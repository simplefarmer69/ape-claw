{
  "rewrites": [
    { "source": "/ui", "destination": "/ui/index.html" },
    { "source": "/app", "destination": "/ui/index.html" },
    { "source": "/skills", "destination": "/ui/skills.html" },
    { "source": "/docs", "destination": "/ui/docs.html" },
    { "source": "/pod", "destination": "/ui/pod.html" },
    { "source": "/forge", "destination": "/ui/forge/index.html" },
    { "source": "/dashboard", "destination": "/ui/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, x-agent-id, x-agent-token" }
      ]
    }
  ]
}
